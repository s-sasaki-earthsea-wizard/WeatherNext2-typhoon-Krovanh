# Copy to .env and fill in. Never commit .env.
# CDS credentials are NOT here: cdsapi reads ~/.cdsapirc (url + key).
#
# The top-level Makefile reads this file with `-include`, so make parses it:
# plain KEY=value lines only, no quotes, no `export`, no command substitution.

# SSH config alias for the RunPod pod. Pods are created per run, so rewrite the
# matching Host block in ~/.ssh/config each time a new pod comes up.
#
# The alias must point at the pod's exposed TCP port. An ssh.runpod.io proxy
# alias will not do: it carries interactive sessions only, and refuses even a
# non-interactive command ("Your SSH client doesn't support PTY"), so neither
# rsync nor the reachability check in runpod/sync.sh can use it. Keeping a
# second alias for the proxy is fine; this variable has to name the direct one.
RUNPOD_HOST=<ssh alias pointing at the pod's exposed TCP port>

# Persistent working directory on the pod, on the network volume mount.
RUNPOD_WORKDIR=<absolute path to the checkout on the pod's volume>

# Where pulled results live. runpod/sync.sh writes here and symlinks
# outputs/<case> to the matching directory so analysis runs in the working
# copy. Its parent has to exist, which is how an unmounted NAS is detected.
RESULTS_ROOT=<absolute path to the results directory, e.g. on the NAS>
