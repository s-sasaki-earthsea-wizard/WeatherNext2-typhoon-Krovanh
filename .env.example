# Copy to .env and adjust. Never commit .env.
# CDS credentials are NOT here: cdsapi reads ~/.cdsapirc (url + key).

# SSH config alias for the RunPod pod. Pods are created per run, so rewrite
# the matching Host block in ~/.ssh/config each time a new pod comes up.
# It must point at the pod's exposed TCP port, not ssh.runpod.io: the proxy
# carries interactive sessions but not rsync.
RUNPOD_HOST=runpod
# Persistent working directory on the pod (30 GB network volume mount)
RUNPOD_WORKDIR=/workspace/WeatherNext2-typhoon-Krovanh

# Where pulled results live. runpod/sync.sh writes here and symlinks
# outputs/<case> to the matching directory so analysis runs in the working copy.
RESULTS_ROOT=/Volumes/EW-NAS-Atoll/WeatherNext2-typhoon-Krovanh
