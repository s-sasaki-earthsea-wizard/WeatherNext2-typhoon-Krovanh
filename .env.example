# Copy to .env and adjust. Never commit .env.
# CDS credentials are NOT here: cdsapi reads ~/.cdsapirc (url + key).

# SSH config alias for the RunPod pod (see ~/.ssh/config)
RUNPOD_HOST=runpod
# Persistent working directory on the pod (network volume mount)
RUNPOD_WORKDIR=/workspace/WeatherNext2-typhoon-Krovanh
