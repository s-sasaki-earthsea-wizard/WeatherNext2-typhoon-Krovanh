# Copy to .env and adjust. Never commit .env.
# CDS credentials are NOT here: cdsapi reads ~/.cdsapirc (url + key).

# SSH config alias for the RunPod pod. Pods are created per run, so rewrite
# the matching Host block in ~/.ssh/config each time a new pod comes up.
RUNPOD_HOST=runpod
# Persistent working directory on the pod (network volume mount)
RUNPOD_WORKDIR=/workspace/WeatherNext2-typhoon-Krovanh
